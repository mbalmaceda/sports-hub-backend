# Requeridas: sin ellas el backend no arranca.
#
# La API usa el endpoint con pooler. Las migraciones NO: hay que correrlas
# contra el endpoint directo (el mismo host sin '-pooler'), porque el lock con
# el que golang-migrate se serializa es de sesión y un pooler en modo
# transacción lo puede perder. `migrate` avisa si lo apuntás al pooler.
DATABASE_URL=postgres://user:pass@localhost:5432/sportshub?sslmode=disable
# Mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_un_valor_random_de_al_menos_32_bytes

# Opcionales.
PORT=8080

# Solo durante una rotación de JWT_SECRET: se firma con el actual y se sigue
# aceptando este por 15 minutos, que es lo que dura un access token. Pasado ese
# rato se borra. Nadie se desloguea.
# JWT_SECRET_PREVIOUS=

# JSON completo de la cuenta de servicio, en una línea. Sin esto el backend
# arranca igual y solo queda fuera lo que depende de Firestore.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# CORS solo afecta a navegadores: la app móvil no manda Origin y lo ignora.
# Si no hay frontend web, CORS_ENABLED=false.
CORS_ENABLED=true
# Reemplaza la lista por defecto (los puertos del dev server de Expo), así que
# dejala sin setear en local o perdés el dev de la app.
#
# El valor de producción vive en fly.toml, no acá:
#   https://zports.cl,https://www.zports.cl,https://zports-web.vercel.app
# CORS_ALLOWED_ORIGINS=
#
# Para los preview deploys de Vercel, que estrenan subdominio en cada commit.
# Hoy no se usa: habilitarlos dejaría que cualquier rama escriba en la base de
# producción. Si algún día se activa, tiene que ir anclada con ^ y $ y acotada
# al proyecto — un *.vercel.app a secas habilita el deploy de cualquiera.
# CORS_ALLOWED_ORIGIN_REGEX=^https://zports-web-[a-z0-9-]+\.vercel\.app$

# Tamaño máximo del cuerpo de un request, en bytes. Por defecto 1 MB.
# MAX_BODY_BYTES=1048576

# Origen con el que se arman los enlaces de invitación ("parches"), sin barra
# final. SIN ESTO EL FLUJO NO SE PUEDE PROBAR: el backend devuelve el enlace
# vacío y la app avisa que las invitaciones no están habilitadas, en vez de
# compartir una URL rota por WhatsApp.
#
# En local va la IP de tu máquina en la red —la misma que pusiste en el
# EXPO_PUBLIC_API_URL de la app—, no localhost: el enlace lo abre el teléfono.
# Ahí se acepta http; para cualquier host público se exige https, porque Android
# e iOS solo verifican App Links sobre HTTPS y un http abriría el navegador en
# vez de la app, en silencio.
#
# El valor de producción va por `fly secrets set`, no acá:
#   https://sports-hub-backend.fly.dev
# PUBLIC_BASE_URL=http://192.168.1.100:8085

# A dónde mandar a quien abre el enlace y no tiene la app. Vacío esconde el
# botón en vez de llevar a una página rota.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.zports.app

# Audiencias que se aceptan en el ID token de "Entrar con Google", separadas por
# coma: el client id web (el que usa Android) y el de iOS. Vacío desactiva el
# endpoint /auth/google, que contesta 503 en vez de fallar de forma rara.
#
# Salen de `google-services.json` (oauth_client tipo 3 = web) y de
# `GoogleService-Info.plist` (CLIENT_ID) del repo mobile. El valor de producción
# vive en fly.toml, no acá: no son secretos.
# GOOGLE_CLIENT_IDS=xxx-web.apps.googleusercontent.com,xxx-ios.apps.googleusercontent.com

# Habilita `make seed`, que crea usuarios con una contraseña conocida.
# Nunca en una base compartida.
# ALLOW_SEED=true
